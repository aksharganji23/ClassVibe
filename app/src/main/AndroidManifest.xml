<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal permission set. No SMS, contacts, location, camera, storage,
         accessibility or overlay permissions. -->
    <!-- One-tap updates: lets ClassVibe hand its own verified update to Android's installer.
         The user switches it on once ("Install unknown apps"). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Exact alarms for a reminder-style app (auto-granted on Android 13+).
         If you publish on Google Play, review Play's exact-alarm policy. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only used for the optional GitHub update check (can be switched off in Settings). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".ClassVibeApp"
        android:allowBackup="true"
        android:backupAgent=".backup.ClassVibeBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ClassVibe">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ClassVibe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- All reminder alarms (classes, class end, exams, weekend prep, morning summary) -->
        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

        <!-- Attended / Missed buttons on notifications -->
        <receiver
            android:name=".notifications.AttendanceActionReceiver"
            android:exported="false" />

        <!-- 👍 / 👎 buttons on reminder notifications -->
        <receiver
            android:name=".notifications.RateActionReceiver"
            android:exported="false" />

        <!-- Re-registers alarms after reboot / app update / clock change -->
        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Update download finished (sent by the system DownloadManager) -->
        <receiver
            android:name=".update.DownloadCompleteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Result of installing an update (sent by Android's PackageInstaller) -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Home-screen widget -->
        <receiver
            android:name=".widget.NowNextWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_now_next_info" />
        </receiver>

        <!-- Shares a temporary file with the camera app for "Take a photo" import -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
